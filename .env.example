# Copy to server/.env (or set as environment variables on your host).

PORT=3000
# Where the database and uploaded photos are kept. BACK THIS FOLDER UP.
DATA_DIR=./data
# The public address of the app (used for eSewa redirects and payment links).
APP_URL=https://slay.example.com
NODE_ENV=production

# Optional: create both logins on first start (username:Display Name:password, comma separated).
# Remove it after the first start. Passwords need at least 8 characters.
# INITIAL_USERS=teza:Teza:change-me-123,partner:Partner:change-me-456

# ── eSewa ──
# "test" uses eSewa's sandbox (product code EPAYTEST, public test secret) – no setup needed.
# For real payments set ESEWA_MODE=production plus the merchant code & secret eSewa gives you.
ESEWA_MODE=test
# ESEWA_PRODUCT_CODE=
# ESEWA_SECRET_KEY=

# ── Voice (optional) ──
# Server speech-to-text for phones whose browser can't recognise Nepali (e.g. iPhone).
# Any Whisper-compatible API works (OpenAI, Groq, a self-hosted whisper server…).
# TRANSCRIBE_API_KEY=
# TRANSCRIBE_API_URL=https://api.openai.com/v1/audio/transcriptions
# TRANSCRIBE_MODEL=whisper-1

# ── Security alerts (optional extra channel) ──
# Alerts always appear in the app and as phone notifications (once turned on in Security).
# Also POST them to a URL, e.g. an ntfy.sh topic both partners subscribe to:
# ALERT_WEBHOOK_URL=https://ntfy.sh/your-secret-topic-name
# VAPID_SUBJECT=mailto:you@example.com
